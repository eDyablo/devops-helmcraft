{{- define "shortName" -}}
  {{- $length := index . 0 }}
  {{- $name := index . 1 }}
  {{- if le (len $name) $length }}
    {{- $name }}
  {{- else }}
    {{- $digest := $name | sha1sum }}
    {{-
      (list
        ($name | trunc (sub $length 6 | int) | trimSuffix "-")
        ($digest | trunc -5)
        | compact | join "-"
      )
    }}
  {{- end }}
{{- end }}

{{- define "releaseName" -}}
  {{- $context := index . 0 }}
  {{- $name := index . 1 | toString }}
  {{- $nameMaxLength := 53 }}
  {{- $namePrefix := $context.Values | getOrNil "releaseNamePrefix" }}
  {{- $nameSuffix := $context.Values | getOrNil "releaseNameSuffix" }}
  {{- include "shortName"
    (list
      $nameMaxLength
      (list
        $namePrefix $name $nameSuffix
        | compact | join ""
      )
    )
  }}
{{- end }}

helmDefaults:
  {{- with .Values | getOrNil "helmDefaults" }}
  {{ . | toYaml | nindent 2 }}
  {{- end }}

repositories:
  - name: bitnami.com
    url: https://charts.bitnami.com/bitnami/
  - name: external-secrets.io
    url: https://charts.external-secrets.io/
  - name: gitlab.io
    url: http://charts.gitlab.io/
  - name: nats.io
    url: https://nats-io.github.io/k8s/helm/charts/

templates:
  basic:
    {{- with .Values | getOrNil "namespace" }}
    namespace: {{ . }}
    {{- end }}
    kubeContext: {{ .Values.kubeContext }}
    labels:
      {{- with .Values | getOrNil "labels" }}
      {{ . | toYaml | trim | nindent 6 }}
      {{- end }}
      context: {{ .Values.kubeContext }}
      path: {{ exec "pwd" list | trim
          | trimPrefix .Values.infrastructureDirPath | trimAll "/"
      }}
    values:
      {{- with .Values | getOrNil "global.containerImageRegistry" }}
      - global:
          image:
            registry: {{ . }}
          imageRegistry: {{ . }}
          security:
            allowInsecureImages: true
      {{- end }}
  external-secrets:
    inherit:
      - template: basic
    chart: external-secrets.io/external-secrets
    condition: externalSecrets.enabled
    name: {{ include "releaseName" (list . "external-secrets") }}
    values:
      {{- with .Values | getOrNil "externalSecrets" }}
      - {{ . | toYaml | trim | nindent 8 }}
      {{- end }}
    version: 0.20.1
  gitlab:
    inherit:
      - template: basic
    chart: gitlab.io/gitlab
    name: {{ include "releaseName" (list . "gitlab") }}
    values:
      {{- with .Values | getOrNil "gitlab" }}
      - {{ . | toYaml | trim | nindent 8 }}
      {{- end }}
    version: 9.4.1
  mariadb:
    inherit:
      - template: basic
    chart: bitnami.com/mariadb
    name: {{ include "releaseName" (list . "mariadb") }}
    set:
      {{- with
          list
            (.Values.kubeContext | printf "--context=%s")
            (list "" (.Values | getOrNil "namespace") | join "--namespace=")
            "get"
            "--ignore-not-found"
            "secret"
            (include "releaseName" (list . "mariadb"))
            "--output=go-template='{{index .data \"mariadb-root-password\" | base64decode}}'"
          | compact | exec "kubectl" | trim
        }}
        - name: auth.rootPassword
          value: {{ . }}
        {{- end }}
    strategicMergePatches:
      {{- with .Values
          | getOrNil "global.persistentVolumeClaimRetentionPolicy"
      }}
      - apiVersion: apps/v1
        kind: StatefulSet
        metadata:
          name: {{ include "releaseName" (list $ "mariadb") }}
          {{- with $.Values | getOrNil "namespace" }}
          namespace: {{ . }}
          {{- end }}
        spec:
          persistentVolumeClaimRetentionPolicy:
            whenDeleted: {{ .whenDeleted }}
      {{- end }}
    values:
      {{- with .Values | getOrNil "mariadb" }}
      - {{ . | toYaml | trim | nindent 8 }}
      {{- end }}
    version: 22.0.0
  minio:
    inherit:
      - template: basic
    chart: bitnami.com/minio
    name: {{ include "releaseName" (list . "minio") }}
    values:
      {{- with .Values | getOrNil "minio" }}
      - {{ . | toYaml | trim | nindent 8 }}
      {{- end }}
    version: 17.0.21
  memcached:
    inherit:
      - template: basic
    chart: bitnami.com/memcached
    name: {{ include "releaseName" (list . "memcached") }}
    values:
      {{- with .Values | getOrNil "memcached" }}
      - {{ . | toYaml | trim | nindent 8 }}
      {{- end }}
    version: 7.9.7
  nats:
    inherit:
      - template: basic
    chart: nats.io/nats
    name: {{ include "releaseName" (list . "nats") }}
    values:
      {{- with .Values
          | getOrNil "global.persistentVolumeClaimRetentionPolicy"
      }}
      - statefulSet:
          merge:
            spec:
              persistentVolumeClaimRetentionPolicy:
                whenDeleted: {{ .whenDeleted }}
      {{- end }}
      {{- with .Values | getOrNil "nats" }}
      - {{ . | toYaml | trim | nindent 8 }}
      {{- end }}
    version: 1.3.14
  nginx:
    inherit:
      - template: basic
    chart: bitnami.com/nginx
    name: {{ include "releaseName" (list . "nginx") }}
    values:
      {{- with .Values | getOrNil "nginx" }}
      - {{ . | toYaml | trim | nindent 8 }}
      {{- end }}
    version: 21.1.23
  postgresql:
    inherit:
      - template: basic
    chart: bitnami.com/postgresql
    name: {{ include "releaseName" (list . "postgesql") }}
    values:
      {{- with .Values
          | getOrNil "global.persistentVolumeClaimRetentionPolicy"
      }}
      - primary:
          persistentVolumeClaimRetentionPolicy:
            enabled: true
            whenDeleted: {{ .whenDeleted }}
        readReplicas:
          persistentVolumeClaimRetentionPolicy:
            enabled: true
            whenDeleted: {{ .whenDeleted }}
      {{- end }}
      {{- with .Values | getOrNil "postgresql" }}
      - {{ . | toYaml | trim | nindent 8 }}
      {{- end }}
    version: 16.7.27
  redis:
    inherit:
      - template: basic
    chart: bitnami.com/redis
    name: {{ include "releaseName" (list . "redis") }}
    set:
      {{- with
        list
          (.Values.kubeContext | printf "--context=%s")
          (list "" (.Values | getOrNil "namespace") | join "--namespace=")
          "get"
          "--ignore-not-found"
          "secret"
          (include "releaseName" (list . "redis"))
          "--output=go-template='{{index .data \"redis-password\" | base64decode}}'"
        |compact | exec "kubectl" | trim
      }}
      - name: auth.password
        value: {{ . }}
      {{- end }}
    values:
      {{- with .Values
          | getOrNil "global.persistentVolumeClaimRetentionPolicy"
      }}
      - master:
          persistentVolumeClaimRetentionPolicy:
            enabled: true
            whenDeleted: {{ .whenDeleted }}
        replica:
          persistentVolumeClaimRetentionPolicy:
            enabled: true
            whenDeleted: {{ .whenDeleted }}
        sentinel:
          persistentVolumeClaimRetentionPolicy:
            enabled: true
            whenDeleted: {{ .whenDeleted }}
      {{- end }}
      {{- with .Values | getOrNil "redis" }}
      - {{ . | toYaml | trim | nindent 8 }}
      {{- end }}
    version: 22.0.7
  sealed-secrets:
    inherit:
      - template: basic
    chart: bitnami.com/sealed-secrets
    name: {{ include "releaseName" (list . "sealed-secrets") }}
    values:
      {{- with .Values | getOrNil "sealedSecrets" }}
      - {{ . | toYaml | trim | nindent 8 }}
      {{- end }}
    version: 2.5.19
  secrethub:
    inherit:
      - template: basic
    chart: {{ .Values.rootDirPath }}/charts/secrethub
    name: {{ include "releaseName" (list . "secrethub") }}
    values:
      {{- range .Values | getOrNil "secrethub.readFrom" }}
        {{- with . | getOrNil "dir" }}
        {{- $secretsDirPath :=
            list ($.Values | getOrNil "helmfileDirPath") . | compact | join "/"
        }}
      - secrets:
        {{- range readDir $secretsDirPath }}
          - |-
            {{ readFile . | nindent 12 }}
        {{- end }}
        {{- end }}
      {{- end }}
