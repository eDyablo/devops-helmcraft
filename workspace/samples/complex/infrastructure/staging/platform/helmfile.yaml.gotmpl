bases:
  - {{ list . "templates/basic.yaml.gotmpl" | tpl .Values.helpers.getHelmcraftResourcePath }}
  - {{ list . "templates/mysql.yaml.gotmpl" | tpl .Values.helpers.getHelmcraftResourcePath }}

releases:
  - inherit:
      - template: mysql
    name: {{ list . "first" | tpl .Values.helpers.releaseName }}
    installed: true
