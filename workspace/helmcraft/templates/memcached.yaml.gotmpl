repositories:
  - name: bitnami.com
    url: https://charts.bitnami.com/bitnami/

templates:
  memcached:
    inherit:
      - template: basic
    chart: bitnami.com/memcached
    name: {{ tpl .Values.helpers.releaseName (list . "memcached") }}
    values:
      {{- with .Values | getOrNil "memcached" }}
      - {{ . | toYaml | trim | nindent 8 }}
      {{- end }}
    version: 7.9.7
