repositories:
  - name: bitnami.com
    url: https://charts.bitnami.com/bitnami/

templates:
  sealed-secrets:
    inherit:
      - template: basic
    chart: bitnami.com/sealed-secrets
    name: {{ tpl .Values.helpers.releaseName (list . "sealed-secrets") }}
    values:
      {{- with .Values | getOrNil "sealedSecrets" }}
      - {{ . | toYaml | trim | nindent 8 }}
      {{- end }}
    version: 2.5.19
