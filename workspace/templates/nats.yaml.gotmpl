repositories:
  - name: nats.io
    url: https://nats-io.github.io/k8s/helm/charts/

templates:
  nats:
    inherit:
      - template: basic
    chart: nats.io/nats
    name: {{ tpl .Values.helpers.releaseName (list . "nats") }}
    values:
      {{- with .Values
        | getOrNil "global.persistentVolumeClaimRetentionPolicy"
      }}
      - statefulSet:
          merge:
            spec:
              persistentVolumeClaimRetentionPolicy:
                whenDeleted: {{ .whenDeleted }}
      {{- end }}
      {{- with .Values | getOrNil "nats" }}
      - {{ . | toYaml | trim | nindent 8 }}
      {{- end }}
    version: 1.3.14
